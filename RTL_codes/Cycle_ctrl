`timescale 1ns/1ps

module cycle_ctrl (
    input  wire       clk,
    input  wire       rst_n,
    input  wire       start,
    input  wire [3:0] Active_Depth,
    input  wire       EX,             // registered EX from early_exit.v
    input  wire       fme_final,
    output reg  [2:0] COUNT,
    output wire       DONE,
    output wire       normal_done,
    output wire       accum_en
);

    reg running;
    wire depth_is_2 = (Active_Depth == 4'd2);
    wire depth_is_4 = (Active_Depth == 4'd4);

    wire final_cycle;
    assign final_cycle = running &
                        ((depth_is_2 & (COUNT == 3'd1)) |
                         (depth_is_4 & (COUNT == 3'd3)) |
                         (~depth_is_2 & ~depth_is_4 & (COUNT == 3'd7)));

    assign DONE        = running & (EX | fme_final | final_cycle);
    assign normal_done = final_cycle & ~fme_final & ~EX;
    assign accum_en    = running & ~EX & ~normal_done & ~fme_final;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            COUNT   <= 3'd0;
            running <= 1'b0;
        end
        else if (DONE) begin
            COUNT   <= 3'd0;
            running <= 1'b0;
        end
        else if (start & ~running) begin
            COUNT   <= 3'd0;
            running <= 1'b1;
        end
        else if (running) begin
            COUNT   <= COUNT + 3'd1;
        end
    end

endmodule
